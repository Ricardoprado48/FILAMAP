# USO OPCIONAL, PRINCIPALMENTE PARA DESENVOLVIMENTO/TESTE.
#
# Cliente comercial NÃO precisa deste arquivo: ao rodar o Agent sem essas
# variáveis (e sem um cadastro salvo anterior), um assistente interativo no
# próprio terminal pede e-mail/senha da conta Filamap, número de série e
# Access Code da impressora uma única vez, e salva o resultado na pasta de
# configuração do usuário no SO (ver desktop-agent/README.md). Da próxima
# vez o Agent inicia sozinho, sem perguntar de novo e sem terminal.
#
# Se quiser mesmo assim usar .env (dev, CI, múltiplas contas de teste):
# copie este arquivo para ".env" na mesma pasta do filamap-agent.exe (ou do
# projeto) e preencha. Nunca compartilhe o ".env" preenchido -- ele não deve
# ser commitado nem distribuído junto com o executável. Variáveis aqui têm
# prioridade sobre a configuração salva pelo assistente.

SUPABASE_URL=https://gqtlszffgvxsqcmefhyd.supabase.co
# Em branco = usa o mesmo valor público já embutido no Web App (ver
# desktop-agent/src/config/store.ts). Só preencha para apontar pra outro projeto Supabase.
SUPABASE_ANON_KEY=

# Login da SUA conta Filamap (o mesmo usado no app web/PWA).
AGENT_EMAIL=
AGENT_PASSWORD=

# Deixe PRINTER_IP em branco para descoberta automática por UDP na rede local.
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=
