# Este arquivo é OPCIONAL -- só necessário para desenvolvimento, CI ou
# contas de teste. O cliente final não precisa de ".env": o Agent tem um
# assistente de configuração interativo que pergunta só o que falta e
# salva fora do projeto (ver README.md, seção "Fluxo de onboarding
# comercial"). Se preenchido, ".env" tem prioridade sobre tudo o mais.
#
# Copie este arquivo para ".env" na mesma pasta do filamap-agent.exe (ou do
# projeto, em modo dev) e preencha com os dados da SUA conta e impressora.
# Nunca compartilhe o arquivo ".env" preenchido -- ele não deve ser commitado
# nem distribuído junto com o executável.

# Em branco = usa a URL/anon key pública padrão já embutida no código
# (mesmo par que o web-app já publica no bundle JS -- não é segredo,
# protegido por RLS). Preencha só se for usar outro projeto Supabase
# (ex.: instância de teste).
SUPABASE_URL=https://gqtlszffgvxsqcmefhyd.supabase.co
SUPABASE_ANON_KEY=

# Login da SUA conta Filamap (o mesmo usado no app web/PWA).
AGENT_EMAIL=
AGENT_PASSWORD=

# Deixe PRINTER_IP em branco para descoberta automática por UDP na rede local.
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=

# Opcional: permite pular o login por senha em execuções seguintes,
# reaproveitando uma sessão Supabase (pegue o refresh_token de uma sessão
# já autenticada, ex. via Supabase Studio ou pelo próprio app web logado).
# O Agent NUNCA grava isso em log ou em disco por conta própria -- só lê
# daqui. Não é assim que o cliente final vai funcionar -- ver
# docs/11_AGENT_ONBOARDING_V2.md sobre o cofre de segredos do SO, ainda não
# implementado.
SUPABASE_REFRESH_TOKEN=
