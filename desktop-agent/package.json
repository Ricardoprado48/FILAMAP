  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "dotenv": "^16.4.5",
    "mqtt": "^5.3.5",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "typescript": "^5.3.3"
  }
}